        # Negative dt for backward tracking
        dt = -float(step_days * 24 * 60 * 60)
        
        current_time = float(t_start)
        x_curr, p_curr = self.x, self.p
        
        while current_time > t_target:
            if current_time + dt < t_target:
                dt = t_target - current_time
                
            drift = self.get_epoch_drift(current_time)
            x_curr, p_curr = self.quantum_unitary_step(x_curr, p_curr, dt, drift)
            current_time += dt
            
        return x_curr, p_curr

